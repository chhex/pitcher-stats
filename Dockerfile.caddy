# Stage 1: Build Svelte frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build


# Stage 2: Caddy + frontend
FROM caddy:2-alpine

COPY Caddyfile /etc/caddy/Caddyfile

COPY --from=frontend-builder /app/build /srv/build