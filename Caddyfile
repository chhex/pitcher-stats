# Nur HTTP: TLS terminiert Cloudflare, der Tunnel "nuc2" holt die Seite
# auf 127.0.0.1:8081 ab (siehe docker-compose.nuc.yaml).
:80 {
    root * /srv/build

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8000
    }

    handle {
        file_server
        try_files {path} {path}/ /index.html
    }

    encode gzip
}
