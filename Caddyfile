# Hetzner: Default (pitcher.watch, www) mit automatischem HTTPS
# NUC 2:   SITE_ADDRESS=:80 -> nur HTTP, TLS macht Cloudflare
{$SITE_ADDRESS:pitcher.watch, www.pitcher.watch} {
    root * /srv/build

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8000
    }

    handle {
        file_server
        try_files {path} {path}/ /index.html
    }

    encode gzip
}
